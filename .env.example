# Copy this file to .env for local dev (never commit the real .env).
# In production, set these in your Vercel project's Environment Variables instead.

# Required — get this from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Optional — only needed for the "Share trip by code" feature.
# Get these free from upstash.com (create a Redis database, copy from its REST API tab).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
