# Copy this file to .env for local dev (never commit the real .env).
# In production, set these in your Vercel project's Environment Variables instead.

# Required — get this from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Optional — Booking.com Affiliate ID from your Partner Hub dashboard.
# Once set, hotel booking links include it so bookings get credited to your account.
# Note: this one needs the VITE_ prefix since it's read in the browser, not the server.
VITE_BOOKING_AID=

# Optional — destination photos in the itinerary. Free key from unsplash.com/developers
# (create an app, use its Access Key). Without this, images just don't render — nothing breaks.
UNSPLASH_ACCESS_KEY=

# Optional — only needed for the "Share trip by code" feature.
# Get these free from upstash.com (create a Redis database, copy from its REST API tab).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
