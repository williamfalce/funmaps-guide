{
  "functions": {
    "api/claude.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/rate-card",
      "destination": "/api/listings?resource=rate-card"
    },
    {
      "source": "/api/stories",
      "destination": "/api/listings?resource=stories"
    },
    {
      "source": "/api/subscribe",
      "destination": "/api/listings?resource=subscribe"
    },
    {
      "source": "/api/destinations",
      "destination": "/api/listings?resource=destinations"
    },
    {
      "source": "/api/latest",
      "destination": "/api/listings?resource=latest"
    },
    {
      "source": "/guide",
      "destination": "/api/listings?resource=latest&go=guide"
    },
    {
      "source": "/newsletter",
      "destination": "/api/listings?resource=latest&go=newsletter"
    },
    {
      "source": "/api/banner-click",
      "destination": "/api/click?type=banners"
    },
    {
      "source": "/api/deal-click",
      "destination": "/api/click?type=deals"
    },
    {
      "source": "/api/sponsorship-click",
      "destination": "/api/click?type=sponsorships"
    },
    {
      "source": "/site",
      "destination": "/index.html"
    },
    {
      "source": "/site/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
